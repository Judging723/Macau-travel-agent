TRAVEL_AGENT_APP_NAME=Macao Travel Agent API
TRAVEL_AGENT_APP_VERSION=0.1.0
TRAVEL_AGENT_ENVIRONMENT=development
TRAVEL_AGENT_DEBUG=false
TRAVEL_AGENT_API_PREFIX=/api/v1
TRAVEL_AGENT_DATABASE_URL=postgresql+asyncpg://travel_agent:travel_agent_dev@127.0.0.1:5432/travel_agent
TRAVEL_AGENT_JWT_SECRET_KEY=replace-with-a-random-secret
TRAVEL_AGENT_ACCESS_TOKEN_EXPIRE_MINUTES=30
TRAVEL_AGENT_DEEPSEEK_API_KEY=
TRAVEL_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash
TRAVEL_AGENT_EMBEDDING_MODEL=qwen3-embedding:4b
TRAVEL_AGENT_TAVILY_API_KEY=
TRAVEL_AGENT_CHROMA_HOST=127.0.0.1
TRAVEL_AGENT_CHROMA_PORT=8001
TRAVEL_AGENT_CHROMA_COLLECTION=macau_travel_knowledge
TRAVEL_AGENT_RAG_TOP_K=5
TRAVEL_AGENT_RAG_SCORE_THRESHOLD=0.2
